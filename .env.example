# Kicktipp login (same credentials you use on kicktipp.de)
KICKTIPP_USERNAME=you@example.com
KICKTIPP_PASSWORD=changeme

# The "community" slug from your group's URL:
# https://www.kicktipp.de/<KICKTIPP_COMMUNITY>/tippabgabe
KICKTIPP_COMMUNITY=your-group-slug

# Only auto-tip games starting within this many minutes.
# Keeps the bot from overwriting tips you plan to place yourself,
# it only steps in shortly before the deadline.
TIP_LEAD_TIME_MINUTES=90

# Never touch a game you already tipped manually (recommended: true)
SKIP_ALREADY_TIPPED=true

# Run Chrome without a visible window (recommended for cron)
HEADLESS=true

# --- Optional: get notified when something needs your attention ---
# (login failure, tipping page structure changed, quotes couldn't be read,
# Kicktipp rejected the submitted tips, or any other unexpected error).
# Without either of these, such failures only show up in logs/kickbot.log.

# Simplest option: free push notifications via https://ntfy.sh - just pick
# a hard-to-guess topic name (no signup needed) and subscribe to it in the
# ntfy app/website.
NTFY_TOPIC=
# Only needed if you self-host ntfy; defaults to https://ntfy.sh
NTFY_URL=https://ntfy.sh

# Alternative/additional: any webhook URL that accepts a JSON POST of
# {"title": "...", "message": "..."} (e.g. a custom endpoint, or an
# n8n/Zapier/Make webhook that forwards to Slack/Discord/email/etc.)
WEBHOOK_URL=

# --- Optional: factor in each team's recent scoring/conceding form ---
# Odds alone tell the bot who's likely to win, but not whether it'll be a
# tight 1:0 or a high-scoring 3:2 - that's what this adds, via the free
# OpenLigaDB API (no signup needed). Only covers German leagues.
# Leave empty to disable (bot stays odds-only, no extra network calls).

# "bl1" = 1. Bundesliga, "bl2" = 2. Bundesliga
TEAM_STATS_LEAGUE=

# Season OpenLigaDB should pull, as the year it started in (2025 = the
# 2025/26 season). Leave empty to auto-detect the current season.
TEAM_STATS_SEASON=

# How much team form shifts the *total* goals prediction (0 = odds only,
# 1 = form only). It never changes who the bot considers the favorite -
# that's still decided purely by the odds.
TEAM_STATS_WEIGHT=0.35

# How many of each team's most recent finished matches to average over.
TEAM_STATS_LOOKBACK=6
